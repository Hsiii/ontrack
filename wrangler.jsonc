{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ontrack",
    "main": "worker/index.ts",
    "compatibility_date": "2026-06-07",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
    },
    "triggers": {
        "crons": ["*/5 * * * *", "10 16 * * *", "30 16 * * *"],
    },
    "observability": {
        "enabled": true,
    },
}
