{
    "name": "ontrack",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:worker": "wrangler dev --test-scheduled",
        "build": "tsc -b && vite build",
        "deploy": "bun run build && wrangler deploy",
        "lint": "eslint .",
        "format": "prettier --write .",
        "preview": "vite preview",
        "prepare": "husky",
        "generate-pwa-assets": "node scripts/generate-pwa-assets.js"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,css,md,html}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "flag-icons": "^7.5.0",
        "lucide-react": "^0.563.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260607.1",
        "@eslint/js": "^9.39.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "sharp": "^0.34.5",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "^7.2.4",
        "vite-plugin-pwa": "^1.2.0",
        "wrangler": "^4.98.0"
    },
    "overrides": {
        "path-to-regexp": "^8.2.0",
        "undici": "^7.2.0"
    }
}
