# Optional TDX API credentials for the Cloudflare Worker.
# Without these, the Worker falls back to TDX Visitor Mode.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Optional Cloudflare Web Analytics token for production web builds.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# iOS release automation. Keep these in a private .env file.
APPLE_TEAM_ID=
ASC_KEY_PATH=
ASC_KEY_ID=
ASC_ISSUER_ID=
IOS_BUNDLE_ID=dev.example.ontrack
