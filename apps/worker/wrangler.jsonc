{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "ontrack-dev",
    "main": "src/index.ts",
    "compatibility_date": "2026-06-07",
    "routes": [
        {
            "pattern": "ontrack.hsichen.dev",
            "custom_domain": true,
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ontrack",
            "database_id": "4f20034f-9bf4-40f6-9122-31b0a151f574",
            "migrations_dir": "d1/migrations",
        },
    ],
    "assets": {
        "binding": "ASSETS",
        "directory": "../../apps/web/out",
        "not_found_handling": "404-page",
        "run_worker_first": true,
    },
    "triggers": {
        "crons": [
            "*/10 * * * *",
        ],
    },
    "observability": {
        "enabled": true,
    },
}
